# Copy this file to .env and fill in your own values. Never commit .env.

# Required for fetching playlists. Create one in Google Cloud Console with
# "YouTube Data API v3" enabled (see README). Server-side only; never sent to the browser.
YOUTUBE_API_KEY=

# Where uploads, converted files and temporary ZIPs are stored (default: ./data)
DATA_DIR=

# Server binding. Keep 127.0.0.1 unless you know you want LAN access.
HOST=127.0.0.1
PORT=5000

# Public deployments: max actions (fetches/downloads) per visitor per minute, 0 = unlimited.
RATE_LIMIT_PER_MINUTE=0
# Number of reverse proxies in front of the app (1 on most hosting platforms, 0 locally).
TRUSTED_PROXIES=0

# Limits
MAX_UPLOAD_MB=200
MAX_PLAYLIST_ITEMS=500
MAX_TRACKS_PER_JOB=200
WORKER_THREADS=2
FFMPEG_TIMEOUT_SECONDS=900

# Uploaded sources and converted files are deleted after this many seconds.
FILE_TTL_SECONDS=7200
CLEANUP_INTERVAL_SECONDS=300

# Optional: comma-separated hosts you are authorised to fetch audio from over
# https (e.g. your own media server). Leave empty to allow uploads only.
# Never add youtube.com or other platforms whose terms forbid downloading.
ALLOWED_SOURCE_HOSTS=
